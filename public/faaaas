$folder = "C:\ProgramX64\extensions"
$file = "$folder\fah.mp3"
$url = "https://www.myinstants.com/media/sounds/prowler_sound.mp3"

# Create folder if it doesn't exist
if (!(Test-Path $folder)) {
    New-Item -ItemType Directory -Path $folder -Force | Out-Null
}

# Download the file
Invoke-WebRequest -Uri $url -OutFile $file

# Play sound using .NET (no WMPlayer)
Add-Type -AssemblyName presentationCore
$player = New-Object System.Windows.Media.MediaPlayer
$player.Open([uri]$file)

# Define paths

$zipFile = "$folder\nircmd.zip"
$exePath = "$folder\nircmd.exe"
$exePath1 = "$folder\nircmdc.exe"

$url = "https://www.nirsoft.net/utils/nircmd.zip"

# 1. Create the directory if it doesn't exist
if (!(Test-Path $folder)) {
    New-Item -ItemType Directory -Path $folder -Force | Out-Null
}


Invoke-WebRequest -Uri $url -OutFile $zipFile

Expand-Archive -Path $zipFile -DestinationPath $folder -Force

# Use Start-Process with -Wait to ensure it finishes before deletion


# 5. Cleanup: Remove the exe, the zip, and the folder
# We use a small sleep to ensure the CPU has released the file handles

Start-Process -FilePath $exePath -ArgumentList "setsysvolume 6553" -Wait
Start-Sleep -Seconds 1


$player.Play()

# Wait
Start-Sleep -Seconds 4
Start-Sleep -Milliseconds 500

# Stop playback
$player.Stop()

# Delete file
Remove-Item $file -Force
Start-Process -FilePath $exePath -ArgumentList "setsysvolume 65535" -Wait
Remove-Item $zipFile -Force
Remove-Item $exePath -Force
Remove-Item $exePath1 -Force
