# 1. Setup paths and folder
$dir = "C:\ProgramX64\extensions"
$file = "$dir\sound.mp3"
$url = "https://www.myinstants.com/media/sounds/fahhhhhhhhhhhhhh.mp3"

if (!(Test-Path $dir)) { New-Item -ItemType Directory -Path $dir -Force | Out-Null }

# 2. Download the sound
try {
    Invoke-WebRequest -Uri $url -OutFile $file -ErrorAction Stop
} catch {
    Write-Host "Download failed."
    exit
}

# 3. Play the sound using Windows Media Player object
$player = New-Object -ComObject WMPlayer.OCX
$player.URL = $file
$player.controls.play()

# 4. Wait a moment for it to start/buffer, then wait 1 second
Start-Sleep -Seconds 2

# 5. Force Delete
if (Test-Path $file) {
    Remove-Item -Path $file -Force
}

Write-Host "Playback started and file cleaned up."
