function Protect-File {
    param (
        [string]$FilePath,
        [string]$p
    )


    $Hasher = [System.Security.Cryptography.SHA256]::Create()
    $Key = $Hasher.ComputeHash([System.Text.Encoding]::UTF8.GetBytes($p))
    

    $Aes = [System.Security.Cryptography.Aes]::Create()
    $Aes.Key = $Key
    $Aes.GenerateIV() # Create a random 'starting' jump for the encryption
    $IV = $Aes.IV


    $RawBytes = [System.IO.File]::ReadAllBytes($FilePath)
    $Encryptor = $Aes.CreateEncryptor()
    $EncryptedBytes = $Encryptor.TransformFinalBlock($RawBytes, 0, $RawBytes.Length)


    $FinalOutput = New-Object Byte[] ($IV.Length + $EncryptedBytes.Length)
    [Array]::Copy($IV, 0, $FinalOutput, 0, $IV.Length)
    [Array]::Copy($EncryptedBytes, 0, $FinalOutput, $IV.Length, $EncryptedBytes.Length)
    
    [System.IO.File]::WriteAllBytes($FilePath + ".crypt", $FinalOutput)
    
}

