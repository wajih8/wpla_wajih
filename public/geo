
Add-Type -AssemblyName System.Device


$Watcher = New-Object System.Device.Location.GeoCoordinateWatcher(1)


$Watcher.Start()

$i=0
while (($i -le 15)-and($Watcher.Status -ne 'Ready') -and ($Watcher.Permission -ne 'Denied')) {
    Start-Sleep -Milliseconds 500
$i++
}

if ($Watcher.Permission -eq 'Denied') {
    Write-Warning "Access Denied. Please enable Location Services in Windows Settings."
} else {
    $Location = $Watcher.Position.Location
    [PSCustomObject]@{
        Latitude  = $Location.Latitude
        Longitude = $Location.Longitude
        Accuracy  = "$($Location.HorizontalAccuracy) meters"
        Altitude  = $Location.Altitude
        Time      = Get-Date
    }
}


$Watcher.Stop()
